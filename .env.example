# ====================================
# GITHUB RELEASES - TOKEN DE ACCESO
# ====================================
# Para publicar actualizaciones a GitHub Releases, necesitas un token personal
# 
# 1. Ve a: https://github.com/settings/tokens
# 2. Crea un "Personal Access Token" (classic)
# 3. Permisos necesarios:
#    - repo (acceso completo)
# 4. Copia el token y pégalo aquí:

GH_TOKEN=tu_github_token_aqui

# ====================================
# INSTRUCCIONES DE USO
# ====================================
# 1. Copia este archivo a .env (sin .example)
# 2. Reemplaza "tu_github_token_aqui" con tu token real
# 3. NUNCA subas el archivo .env a GitHub (está en .gitignore)
#
# Para publicar una actualización:
# npm run release-github

# ====================================
# CODE SIGNING (Opcional)
# ====================================
# Para firmar el instalador de Windows:
# WIN_CSC_LINK=ruta/al/certificado.pfx
# WIN_CSC_KEY_PASSWORD=password_del_certificado

# Para firmar en macOS:
# CSC_LINK=ruta/al/certificado.p12
# CSC_KEY_PASSWORD=password_del_certificado
# APPLE_ID=tu@email.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX
