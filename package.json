{
  "name": "my-church-proyector",
  "version": "0.5.0",
  "private": true,
  "main": "main.js",
  "homepage": ".",
  "description": "GloryView - Aplicación de proyección para iglesias",
  "author": "Alfredo Hammer <coderhammer70@gmail.com>",
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.3",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "jszip": "^3.10.1",
    "node-fetch": "^3.3.2",
    "qrcode": "^1.5.4"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start": "vite",
    "build": "vite build",
    "test": "npm run test:main && npm run test:ui",
    "test:main": "cross-env ELECTRON_RUN_AS_NODE=1 electron tests/ejecutar.js",
    "test:ui": "vitest run",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "electron": "npx electron .",
    "electron-dev": "cross-env NODE_ENV=development npx electron .",
    "electron-prod": "npm run build && cross-env NODE_ENV=production npx electron .",
    "dist": "npm run build && npx electron .",
    "build-exe": "npm run build && electron-builder",
    "build-exe-win": "npm run build && electron-builder --win",
    "pack": "electron-builder --dir",
    "release": "npm run build && electron-builder --publish=never",
    "release-github": "npm run build && electron-builder --win --publish always",
    "release-draft": "npm run build && electron-builder --win --publish onTagOrDraft",
    "neon-logo": "node scripts/neon-logo.js assets/icon-256.png assets/icon-256-neon.png",
    "neon-logo-circulo": "node scripts/neon-lines-logo.js assets/logo-circulo.png assets/logo-circulo-neon.png #00F5FF 130 30",
    "doctor": "react-doctor"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@vitejs/plugin-react": "6.2.1",
    "autoprefixer": "10.6.2",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-icon-builder": "^2.0.1",
    "electron-packager": "^17.1.2",
    "electron-rebuild": "^3.2.9",
    "framer-motion": "^12.8.0",
    "gsap": "^3.15.0",
    "jsdom": "27.4.0",
    "pdfjs-dist": "3.11.174",
    "postcss": "8.5.32",
    "quill": "^2.0.3",
    "rcedit": "^4.0.1",
    "react": "^19.1.0",
    "react-doctor": "^0.2.6",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.5.1",
    "react-toastify": "^11.0.5",
    "sharp": "^0.34.3",
    "suneditor": "^2.47.5",
    "suneditor-react": "^3.6.1",
    "tailwindcss": "^3.4.17",
    "to-ico": "^1.1.5",
    "vite": "8.3.6",
    "vitest": "4.1.12",
    "web-vitals": "^2.1.4"
  }
}
