# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# Electron build output
/dist
/dist-installer
/out

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
build-log.txt
electron-builder-log.txt
final-build.log

# Bases de datos locales (datos de usuario)
/data/*.db
/data/*.db-shm
/data/*.db-wal

# Contenido subido por el usuario en runtime (no son assets del repo)
/public/uploads/*
/public/multimedia/*
/public/fondos/*
!/public/fondos/imagen1.jpg
!/public/fondos/imagen2.png
!/public/fondos/imagen3.jpg
!/public/fondos/video1.mp4
!/public/fondos/video2.mp4
!/public/fondos/video4.mp4

# Environment variables
.env
.env.local
.env.development
.env.development.local
.env.test.local
.env.production.local

# Config local de herramientas de IA
/.agents
/.claude
/.cursor
/.windsurf

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
